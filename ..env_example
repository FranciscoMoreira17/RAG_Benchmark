# ==============================================================================
# RAG Benchmark - Variáveis
# ==============================================================================

GOOGLE_API_KEY=xxx
GROQ_API_KEY=xxx

QDRANT_URL=http://192.168.68.201:6333

# ── Embedding ─────────────────────────────────────────────────
# Modelo E5 (1024 dims) - comum a todas as frameworks
#EMBEDDING_MODEL=intfloat/multilingual-e5-large
#EMBEDDING_DIM=1024
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ── LLM Juiz (Ollama local) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_JUDGE_MODEL=qwen3:14b

# ── Phoenix Tracing ───────────────────────────────────────────
LANGSMITH_API_KEY=xxx
LANGSMITH_PROJECT=rag-benchmark
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Phoenix (já tens o container, só ligar)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# ── Documentos ────────────────────────────────────────────────
DOCS_DIR=./documents
CONTEXT_BUDGET_TOKENS=6000