# ==============================================================================
# RAG Benchmark - Variáveis de ambiente
# Copiar para .env e preencher. Os valores indicados são os defaults do código.
# ==============================================================================

# ── Chaves de API ─────────────────────────────────────────────
GROQ_API_KEY=xxx
GOOGLE_API_KEY=xxx

# ── Vector DB ─────────────────────────────────────────────────
QDRANT_URL=http://192.168.68.201:6333

# ── Embedding (frameworks E5) ─────────────────────────────────
#EMBEDDING_MODEL=intfloat/multilingual-e5-large
#EMBEDDING_DIM=1024
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ── Embedding (frameworks *Qwen) ──────────────────────────────
# Entra no fingerprint dos índices Qwen: mudar obriga a re-ingerir.
#QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ── Modelos LLM ───────────────────────────────────────────────
GEN_MODEL=qwen/qwen3.8-27b
GEN_PROVIDER=groq
# Só registados no snapshot de configuração dos resultados
EXTRACT_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=gemini/gemini-2.5-flash

# ── Juiz LLM (Groq) ───────────────────────────────────────────
JUDGE_MODEL_GROQ=openai/gpt-oss-120b
JUDGE_SLEEP=10
JUDGE_MAX_RETRIES=6

# ── LLM Juiz (Ollama local) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_JUDGE_MODEL=qwen3:14b

# ── Execução ──────────────────────────────────────────────────
# Pausa entre queries (rate limiting do Groq), em segundos
SLEEP_ENTRE_QUERIES=15

# ── Caminhos / dados ──────────────────────────────────────────
DOCS_DIR=./documents
DRE_DIR=./documents/dre_data
DRE_MIN_CHARS=50
DRE_MAX_CHARS=500000


# ── LangSmith ─────────────────────────────────────────────────
LANGSMITH_API_KEY=xxx
LANGSMITH_PROJECT=rag-benchmark
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_DATASET=rag-benchmark-dre

# ── Phoenix Tracing ───────────────────────────────────────────
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
